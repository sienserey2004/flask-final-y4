# Copy this file to .env and fill in your own values.  (.env is never uploaded to GitHub.)
# On Render, set these in Dashboard -> Environment instead.

# Long random text that signs login sessions. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# First admin account (only used when the database is created for the first time)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Shop name shown on the site
SHOP_NAME=Angkor Wellness

# KHQR / Bakong: your real Bakong account so customers pay you
KHQR_ACCOUNT_ID=yourname@bank
KHQR_MERCHANT_CITY=Phnom Penh
KHQR_CURRENCY=USD

# Optional: Bakong API token -> payments are verified automatically (leave empty for demo mode)
BAKONG_TOKEN=

# Testing only: 1 = show a "Test payment" button at checkout (order is marked paid without paying).
# Keep 0 on a real shop, otherwise anyone can order for free.
TEST_PAYMENTS=0

# Optional: use a different database (e.g. Postgres). Empty = SQLite in instance/shop.db
# DATABASE_URL=

# 0 = do not download product photos on first run
SEED_DOWNLOAD_IMAGES=1

# Admin dashboard: "low stock" limit, and the shop's time zone (hours from UTC; Cambodia = 7)
LOW_STOCK_THRESHOLD=5
TZ_OFFSET_HOURS=7
